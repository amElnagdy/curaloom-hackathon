# Copy to the repo root: cp config/.env.example .env
# Never commit .env. Leave values blank here.

# Meta Model API key (https://api.meta.ai/v1). Needed for live and record profiles.
MODEL_API_KEY=

# Product name shown in the UI. Working name, not final. Default: CuraLoom
APP_NAME=

# Course topic used by the demo. Default: <DEMO_TOPIC>
DEMO_TOPIC=

# Provider profile: live | record | replay (see docs/adr/0002). Default: live
PROVIDER_PROFILE=

# Port for pnpm demo:replay, preview and demo:live (demo/run.ts), 1024-65535. Set it to run a second
# demo beside the first. Default: 3107
DEMO_PORT=

# Use the simulated clock (see docs/adr/0004): true | false. Default: true
SIM_CLOCK=

# Notifier channel (see docs/adr/0004): simulated | whatsapp | email. Only simulated sends anything;
# whatsapp and email are documented stubs that throw. Default: simulated
NOTIFIER_ADAPTER=

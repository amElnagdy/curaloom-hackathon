{
  "name": "curaloom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "rm -rf .preview-data && env PROVIDER_PROFILE=replay DEMO_TOPIC='Excel pivot tables for data analysis' DATA_DIR=.preview-data sh -c 'next build && next start -p 3107'",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude \".claude/**\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval:arabic": "node --env-file-if-exists=.env evals/arabic/run.ts",
    "fixtures:record": "RECORD_FIXTURES=1 vitest run smoke.test intake.test architect.test examiner.test coach.test",
    "fixtures:prune": "node demo/fixtures/prune.ts",
    "scout": "node --env-file-if-exists=.env src/server/agents/scout/cli.ts"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.4.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
